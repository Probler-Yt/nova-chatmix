# Maintainer: Probler <https://github.com/Probler-Yt>

pkgname=nova-chatmix
pkgver=1.2.0
pkgrel=1
pkgdesc="Hardware ChatMix dial for the SteelSeries Arctis Nova Pro Wired on Linux, with drag-and-drop app routing and per-output EQ"
arch=('any')
url="https://github.com/Probler-Yt/nova-chatmix"
license=('MIT')
depends=('python' 'libpulse' 'pyside6')
optdepends=('pipewire-pulse: the sound server it is built and tested for (the EQ also needs pipewire itself)')
install=nova-chatmix.install
# The release asset (not GitHub's auto-generated archive) so installs show up
# in the repo's download count.
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('a71136398c9f1a19c287397017334d6ce80ade0291e8e63c0a59124e8f7a0a0f')

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
